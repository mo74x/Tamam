# Server & Web Origins
PORT=3000
CORS_ORIGIN=http://localhost:3001
WEB_APP_URL=http://localhost:3001

# PostgreSQL & Redis
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tamam?schema=public"
REDIS_URL="redis://localhost:6379"

# NestJS Observe telemetry (optional; generated via `pnpm dlx @nestjs/observe link`)
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=

# S3 / Cloudflare R2 / MinIO Object Storage
S3_BUCKET=tamam-proofs
S3_REGION=auto
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# AI Vision & Text Fallback
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.5-flash-lite
GEMINI_VISION_COST_MICRO_USD=500
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5-nano
OPENAI_VISION_COST_MICRO_USD=1500
VISION_PRIMARY=gemini

# WhatsApp Cloud API & Alert Number
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
TAMAM_ALERT_PHONE_NUMBER_ID=
TAMAM_ALERT_ACCESS_TOKEN=
TAMAM_ALERT_BACKUP_PHONE_NUMBER_ID=
TAMAM_ALERT_BACKUP_ACCESS_TOKEN=

# Security (64 hex characters = 32 bytes)
TOKEN_ENCRYPTION_KEY=
JWT_SECRET=
